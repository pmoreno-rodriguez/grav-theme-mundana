 {# PARTIAL AUTHOR FOR PAGES #}

 <!-- Author Box -->
<div class="d-flex flex-wrap justify-content-start align-items-start mt-5">
    <div class="align-self-center mr-2">
    {% if (avatar ?? null) %}
        {{ include('partials/blog/avatar.html.twig', {avatar_width: 80}) }}
    {% endif %}
    </div>
    <div class="align-self-center">
        <p class="font-weight-bold h5">{{ 'MUNDANA.ITEM.WRITTEN_BY'|t }}
            {% if page.taxonomy.author %}
                <a href="{{ blog.url|rtrim('/') ~ '/author' ~ config.system.param_sep ~ (author|url_encode) }}" class="text-{{ color_style|e('html_attr') }}">{{ author|e }}</a>
            {% else %}
                {{ author|e }}
            {% endif %}
            {% if author_twitter %}<span><a target="_blank" rel="noopener noreferrer nofollow" href="{{ author_twitter|e('html_attr') }}" class="btn btn-outline-{{ color_style|e('html_attr') }} btn-sm btn-round ml-2">{{ 'MUNDANA.MISC.FOLLOW'|t }}</a></span>{% endif %}</p>
            {% if author_bio %}{{ author_bio|markdown }}{% endif %}
    </div>
</div>
