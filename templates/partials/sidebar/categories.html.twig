{# CATEGORIES SECTION - SIDEBAR #}

{% set published_posts = blog.children.published(true) %}
{% if published_posts|length > 0 %}

<h4 class="font-weight-bold spanborder">
<span>{{ block_title }}</span>
</h4>

    {% set terms = [] %}
    {% set catItemsCounts = [] %}
    {% set catPreviewImages = [] %}

    {% for item in published_posts %}
        {% set item_categories = item.taxonomy.category|default([]) %}
        {% set item_image = item.media.images[item.header.featuredImage] ?: item.media.images|filter((v, k) => k != item.header.author.avatarImage)|first %}

        {% for cat in item_categories %}
            {% if cat not in terms %}
                {% set terms = terms|merge([cat]) %}
            {% endif %}
            {% set catItemsCounts = catItemsCounts|merge({(cat): (catItemsCounts[cat]|default(0)) + 1}) %}
            {% if catPreviewImages[cat] is not defined and item_image %}
                {% set catPreviewImages = catPreviewImages|merge({(cat): item_image}) %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    {% for term in terms %}
        {# Only show categories that have published posts #}
        {% if catItemsCounts[term] is defined and catItemsCounts[term] > 0 %}
            {% set blog_image = catPreviewImages[term]|default(null) %}
            {% set category_posts_in_label = ('MUNDANA.SIDEBAR.CATEGORIES.POSTS_IN'|t|capitalize) ~ ' ' ~ term %}

            <div class="row align-items-center py-2">
                {% if blog_image %}
                <div class="col-4">
                    {{ blog_image.loading('lazy')
                        .decoding('async')
                        .attribute('width', '100')
                        .attribute('height', '60')
                        .html(category_posts_in_label|e, category_posts_in_label|e, 'w-100 h-auto mr-2 rounded')|raw }}
                </div>
                {% endif %}
                <div class="col-8">
                    <span class="font-weight-bold text-uppercase">
                            <a href="{{ blog.url|rtrim('/')}}/category{{ config.system.param_sep }}{{term|e('url') }}" class="text-{{ color_style|e('html_attr') }}"
                               aria-label="{{ ('MUNDANA.SIDEBAR.CATEGORIES.LINK_TO'|t|capitalize) ~ ' ' ~ term|e('html_attr') }}"
                               {% if current_category is defined and current_category == term %}aria-current="page"{% endif %}>{{ term|e }}</a>
                    </span>
                    <small class="d-block text-muted">
                        <a href="{{ blog.url|rtrim('/')}}/category{{ config.system.param_sep }}{{term|e('url') }}">
                            <span class="text-muted mt-1">{{ catItemsCounts[term] }}
                                {{ 'MUNDANA.SIDEBAR.CATEGORIES.POSTS_IN'|t }}
                                {{ term|capitalize|e }}</span>
                        </a>
                    </small>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endif %}
