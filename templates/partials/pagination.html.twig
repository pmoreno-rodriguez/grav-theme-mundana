{% set pagination = pagination|default(page.collection.params.pagination) %}

{% if pagination|length > 1 %}
<ul class="pagination">
    {% if pagination.hasPrev %}
        <li class="page-item">
            <a class="page-link text-{{ color_style }}" rel="prev" href="{{ base_url ~ pagination.prevUrl }}">&laquo; {{ 'MUNDANA.BLOG.PAGINATION.PREV'|t }}</a>
        </li>
    {% else %}
        <li class="page-item disabled"><span class="prev page-link">&laquo;</span></li>
    {% endif %}

    {% for paginate in pagination %}
        {% if paginate.isCurrent %}
            <li class="page-item disabled"><span class="active webjeda page-link">{{ paginate.number }}</span></li>
        {% elseif paginate.isInDelta %}
            <li class="page-item">
                <a class="page-link text-{{ color_style }}" href="{{ base_url ~ paginate.url }}">{{ paginate.number }}</a>
            </li>
        {% elseif paginate.isDeltaBorder %}
            <li class="gap"><span>&hellip;</span></li>
        {% endif %}
    {% endfor %}

    {% if pagination.hasNext %}
        <li class="page-item">
            <a class="page-link text-{{ color_style }}" rel="next" href="{{ base_url ~ pagination.nextUrl }}">{{ 'MUNDANA.BLOG.PAGINATION.NEXT'|t }} &raquo;</a>
        </li>
    {% else %}
        <li class="page-item disabled"><span class="next page-link">&raquo;</span></li>
    {% endif %}
</ul>
{% endif %}
